# WhatsApp Cloud API Configuration
# This token is used to verify webhook requests from Meta
# Set this to a secure random string and configure it in Meta Business Dashboard
WHATSAPP_VERIFY_TOKEN=your_secure_verify_token_here

# Telegram Bot Configuration
# Get this token from @BotFather on Telegram
# Format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat/Group ID
# This is the ID of the Telegram group where messages will be sent
# Format: -1001234567890 (negative number for groups)
# To get the chat ID, add the bot to a group and use the Telegram API
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Server Configuration
# Port on which the server will listen (optional, defaults to 3000)
PORT=3000
